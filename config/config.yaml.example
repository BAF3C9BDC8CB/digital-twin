# Digital Twin Configuration
# Copy this to config.yaml and customize

server:
  hostname: my-server

services:
  # ── Embed providers (can configure multiple, route via services.embed) ──
  siliconflow:
    url: https://api.siliconflow.cn/v1
    api_key: "your-api-key"
    model_embed: BAAI/bge-m3
    model_reranker: BAAI/bge-reranker-v2-m3
    model_llm: Qwen/Qwen3.5-9B

  xinference:
    url: http://localhost:9997/v1
    api_key: ""
    model_embed: BAAI/bge-m3
    model_reranker: BAAI/bge-reranker-v2-m3
    model_llm: ""

  openai_compatible:
    url: https://glmcoding.cn
    api_key: ""
    model_llm: deepseek-v4-flash

  # Routing: assign each capability to a provider ("siliconflow" or "xinference")
  embed:
    embed_provider: siliconflow    # text embedding
    rerank_provider: siliconflow   # re-ranking
    llm_provider: siliconflow      # LLM chat

  graph:
    url: bolt://localhost:7688
    user: memgraph
    password: ""
  qdrant:
    url: http://localhost:6333

security:
  tls:
    ca_cert: "/etc/dt/ca.pem"
    server_cert: "/etc/dt/server.pem"
    server_key: "/etc/dt/server.key"
  jwt_secret: "env:DT_JWT_SECRET"
  allow_plain_passwords: false

snapshot_dir: /var/lib/digital-twin/snapshots

# Optional: batch processing sizes for build pipeline
# batch:
#   unwind: 200
#   embed: 512
#   upsert: 1000
#   embed_concurrency: 3

# Optional: register projects
# projects:
#   - name: my-project
#     path: /path/to/project